#!/usr/bin/env bash
# Refuses to push a stacked branch (one built on another pushed branch, not
# directly on main) whose own commits change anything besides code, so the
# push never reaches CI. tools/ci-stack-guard.sh has the list; CI runs the
# same check as "stack holds code only".
#
# Offline: it compares against the remote-tracking branches from the last
# fetch. The parent branch is the one sharing the most commits beyond main;
# the branch's own changes are those since its merge base with the parent.
# `nix develop` turns it on (core.hooksPath); elsewhere run
# `git config core.hooksPath tools/git-hooks` once.
set -euo pipefail

remote=$1
zero=0000000000000000000000000000000000000000
main="refs/remotes/$remote/main"
guard="$(git rev-parse --show-toplevel)/tools/ci-stack-guard.sh"

git rev-parse -q --verify "$main" >/dev/null || exit 0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    branch=${remote_ref#refs/heads/}
    [ "$branch" = main ] && continue

    parent="" parent_base="" fewest=""
    while read -r ref; do
        case $ref in "$main" | "refs/remotes/$remote/HEAD" | "refs/remotes/$remote/$branch") continue ;; esac
        base=$(git merge-base "$ref" "$local_sha") || continue
        # Sharing only main's history isn't stacking, and a branch stacked
        # on this one (it holds all of it) isn't its parent.
        git merge-base --is-ancestor "$base" "$main" && continue
        [ "$base" = "$local_sha" ] && continue
        count=$(git rev-list --count "$base..$local_sha")
        if [ -z "$fewest" ] || [ "$count" -lt "$fewest" ]; then
            parent=${ref#refs/remotes/"$remote"/} parent_base=$base fewest=$count
        fi
    done < <(git for-each-ref --format='%(refname)' "refs/remotes/$remote/")

    [ -n "$parent" ] || continue
    if ! git diff --name-only "$parent_base" "$local_sha" | "$guard" "$parent"; then
        echo "pre-push: refused to push $branch, which is stacked on $parent." >&2
        exit 1
    fi
done
